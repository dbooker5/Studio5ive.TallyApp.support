# Base URL of the Studio5ive.Backend.TallyApp server this frontend talks to.
# Every backend URL this app builds (API calls, uploaded images) is derived
# from this — see src/app/lib/env.ts.
#
# Local backend:      http://localhost:1500
# Production backend: https://api.studio5ive.org
VITE_API_BASE_URL=http://localhost:1500

# Must match that backend's own VERSION env var (Studio5ive.Backend.TallyApp/.env).
# Only change this if the backend's API version prefix changes.
VITE_API_VERSION=/v1

# Path prefix for the Help Center API specifically. Only change this if
# the backend's services/help_center/help_center_service.js mount path
# changes independently of VITE_API_VERSION.
VITE_API_PREFIX=/v1/help-center
