# Base URL of the Studio5ive.Backend.TallyApp server (VITE_API_PREFIX is
# appended automatically — see src/app/lib/env.ts).
#
# Local backend:      http://localhost:1500
# Production backend: https://api.studio5ive.org
VITE_API_BASE_URL=http://localhost:1500

# Path prefix for the Help Center API on that backend. Only change this if
# the backend's services/help_center/help_center_service.js mount path
# changes (e.g. a new API version).
VITE_API_PREFIX=/v1/help-center
